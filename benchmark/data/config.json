      "exclusions": [
        {
          "match": {
            "tense": "present",
            "matrix_subj_category": "first_person"
          },
          "reason": "asking about your own current knowledge ('Do I know where the keys are?', 'Where do I know the keys are?') is odd for both verbs"
        },
        {
          "match": {
            "complementizer": "when"
          },
          "reason": "'when' can attach to the matrix verb ('When does John know Mary hid the keys?' = when does he know it), so the extraction isn't unambiguously out of the island"
        },
        {
          "match": {
            "complementizer": "why"
          },
          "reason": "'why' can attach to the matrix verb ('Why does John know Mary hid the keys?' = why does he know it), so the extraction isn't unambiguously out of the island"
